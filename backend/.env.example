# ReStock AI — backend configuration template.
#
# Copy to backend/.env and fill in real values. NEVER commit backend/.env.
#   cp backend/.env.example backend/.env

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_NAME="ReStock AI"
ENVIRONMENT=development          # development | test | production
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# SQLite for local development. Leave unset to use backend/restock_ai.db.
# PostgreSQL example:
#   DATABASE_URL=postgresql+psycopg://restock:restock@localhost:5432/restock_ai
DATABASE_URL=sqlite:///./restock_ai.db

# ---------------------------------------------------------------------------
# LLM provider
# ---------------------------------------------------------------------------
# The agents talk to the provider through an isolated service layer, so the
# provider and model are swappable without touching business logic.
LLM_PROVIDER=openai              # only "openai" is implemented; fakes are test-only
LLM_TIMEOUT_SECONDS=30
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# ---------------------------------------------------------------------------
# RazorpayX (Test / Sandbox Mode ONLY for this project)
# ---------------------------------------------------------------------------
# Dashboard -> Settings -> API Keys (in Test Mode).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Your RazorpayX *source* account number that payouts are debited from.
RAZORPAY_ACCOUNT_NUMBER=
# Dashboard -> Settings -> Webhooks. Used to verify X-Razorpay-Signature.
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_BASE_URL=https://api.razorpay.com/v1
RAZORPAY_TIMEOUT_SECONDS=30

# Payout parameters. mode must be IMPS, NEFT or RTGS (case-sensitive).
# purpose must be a RazorpayX-allowed value or a custom purpose you created.
RAZORPAY_PAYOUT_MODE=IMPS
RAZORPAY_PAYOUT_PURPOSE=vendor bill
RAZORPAY_QUEUE_IF_LOW_BALANCE=false

# ---------------------------------------------------------------------------
# Spend guardrails — enforced by deterministic backend code.
# The LLM can never read, influence, or override these.
# ---------------------------------------------------------------------------
MAX_ORDER_SPEND_INR=10000
MAX_DAILY_SPEND_INR=25000
MAX_REORDER_QUANTITY=500

# IANA timezone whose calendar day defines "today" for the daily cap.
# UTC would roll the day over at 05:30 IST and split one trading day in two.
SPEND_DAY_TIMEZONE=Asia/Kolkata

# ---------------------------------------------------------------------------
# Forecasting
# ---------------------------------------------------------------------------
FORECAST_HISTORY_DAYS=28
