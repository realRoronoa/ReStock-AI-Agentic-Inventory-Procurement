# ReStock AI frontend configuration.
#
# Copy to frontend/.env.local for local overrides. Vite only exposes variables
# prefixed VITE_.
#
# SECURITY: every VITE_-prefixed value is compiled into the JavaScript bundle
# and is therefore PUBLIC. Never put an API key, a Razorpay secret, or any
# credential here. The frontend never talks to RazorpayX or to an LLM directly;
# it only calls this backend.

# Backend base URL.
#
# Leave EMPTY in development: requests then go to the same origin and Vite's dev
# proxy forwards /api and /health to the backend, so there is no CORS to
# configure.
#
# Set it when the backend is on another origin, e.g.
#   VITE_API_BASE_URL=https://api.restock.example.com
VITE_API_BASE_URL=

# Where the dev proxy forwards to. Only used by `npm run dev`.
VITE_DEV_PROXY_TARGET=http://127.0.0.1:8000
